#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
python3 "$repo_root/scripts/check-stable-container-aliases.py"

source_commit=""
while read -r local_ref local_sha remote_ref remote_sha; do
	if [[ "$remote_ref" == "refs/heads/main" && "$local_sha" =~ ^[0-9a-fA-F]+$ && "$local_sha" != *0000000000000000000000000000000000000000 ]]; then
		source_commit="$local_sha"
	fi
done

if [[ -z "$source_commit" ]]; then
	echo "Skipping Unraid sync; this push does not update main."
	exit 0
fi

exec bash "$repo_root/.githooks/sync-packages.sh" pre-push "$source_commit"
